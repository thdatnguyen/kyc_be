# ============================================================================
# Template — copy to `.env` (gitignored) and fill in real values.
# NEVER commit real secrets here.
# ============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=5000
# Reverse-proxy hops to trust for the real client IP (Railway = 1).
TRUST_PROXY=1

# --- Database (local: mongodb://localhost:27017/kyc ; prod: Railway MongoDB plugin / Atlas URI) ---
MONGODB_URI=mongodb://localhost:27017/kyc
MONGO_DB_NAME=kyc

# --- Auth (use strong random values in production) ---
JWT_SECRET=change_me_access_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Account lockout (credential-stuffing defense) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MS=900000
LOGIN_ATTEMPT_TTL_MS=86400000

# --- CORS (comma-separated origins; '*' for local dev) ---
CORS_ORIGIN=*

# --- Logging ---
LOG_DIR=logs

# --- Storage -----------------------------------------------------------------
# driver: "cloudinary" (production) | "local" (dev/CI fallback when no keys)
STORAGE_DRIVER=local
# When STORAGE_DRIVER=local, files are written here (gitignored).
LOCAL_UPLOAD_DIR=uploads
# Cloudinary (fill in later — app auto-switches when these are all set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kyc

# --- Face match (server-side, authoritative) ---
FACE_MATCH_ENABLED=true
FACE_MATCH_THRESHOLD=0.5
