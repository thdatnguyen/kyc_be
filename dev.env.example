# Local development defaults used by docker-compose.
# Copy to `dev.env` (gitignored) and fill in real Cloudinary keys when ready:
#   cp dev.env.example dev.env
NODE_ENV=development
PORT=5000
TRUST_PROXY=1

MONGODB_URI=mongodb://admin:password@mongodb:27017/kyc?authSource=admin
MONGO_DB_NAME=kyc

JWT_SECRET=dev_access_secret_do_not_use_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_do_not_use_in_production
JWT_REFRESH_EXPIRES_IN=30d

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MS=900000
LOGIN_ATTEMPT_TTL_MS=86400000

CORS_ORIGIN=*
LOG_DIR=/app/logs

# Storage: "local" (zero keys) or "cloudinary" (when CLOUDINARY_* are set).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=/app/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kyc

FACE_MATCH_ENABLED=true
FACE_MATCH_THRESHOLD=0.5
